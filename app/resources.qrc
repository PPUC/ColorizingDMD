        <file alias="new.png">../icons/new.png</file>
        <file alias="open.png">../icons/open.png</file>
        <file alias="save.png">../save.png</file>
        <file alias="import.png">../icons/loadimage.png</file>
        <file alias="add.png">../icons/add.png</file>
        <file alias="addspr.png">../icons/addspr.png</file>
        <file alias="remove.png">../icons/delimage.png</file>
        <file alias="crayon.png">../icons/crayon.png</file>
        <file alias="trait.png">../icons/trait.png</file>
        <file alias="select.png">../icons/select.png</file>
        <file alias="cercle.png">../icons/cercle.png</file>
        <file alias="ellipse.png">../icons/ellipse.png</file>
        <file alias="colpick.png">../icons/colpick.png</file>
